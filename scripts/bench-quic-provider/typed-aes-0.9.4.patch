+#[test]
+fn erase_software_round_keys() {
+    macro_rules! check_erasure {
+        ($cipher:ident, $length:literal) => {{
+            let mut cipher = $cipher::new(&[0x42; $length]);
+            assert!(cipher.rk.iter().any(|&word| word != 0));
+            cipher.erase();
+            assert!(cipher.rk.iter().all(|&word| word == 0));
+        }};
+    }
+    check_erasure!(Aes128, 16);
+    check_erasure!(Aes192, 24);
+    check_erasure!(Aes256, 32);
+}
