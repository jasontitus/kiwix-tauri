+#[test]
+fn encrypt_only_key_conversions() {
+    use aes::{
+        Aes128, Aes128Dec, Aes128Enc, Aes192, Aes192Dec, Aes192Enc, Aes256, Aes256Dec, Aes256Enc,
+        Block,
+        cipher::{BlockCipherDecrypt, BlockCipherEncrypt, KeyInit},
+    };
+    use hex_literal::hex;
+
+    let plaintext = Block::from(hex!("00112233445566778899aabbccddeeff"));
+    macro_rules! check_conversions {
+        ($aes:ty, $enc:ty, $dec:ty, $key:expr, $ciphertext:expr) => {{
+            let enc = <$enc>::new(&$key.into());
+            let full_borrowed = <$aes>::from(&enc);
+            let full_owned = <$aes>::from(enc.clone());
+            let dec_borrowed = <$dec>::from(&enc);
+            let dec_owned = <$dec>::from(enc);
+
+            let expected = Block::from($ciphertext);
+            for full in [full_borrowed, full_owned] {
+                let mut block = plaintext;
+                full.encrypt_block(&mut block);
+                assert_eq!(block, expected);
+                full.decrypt_block(&mut block);
+                assert_eq!(block, plaintext);
+            }
+            for dec in [dec_borrowed, dec_owned] {
+                let mut block = expected;
+                dec.decrypt_block(&mut block);
+                assert_eq!(block, plaintext);
+            }
+        }};
+    }
+
+    check_conversions!(
+        Aes128,
+        Aes128Enc,
+        Aes128Dec,
+        hex!("000102030405060708090a0b0c0d0e0f"),
+        hex!("69c4e0d86a7b0430d8cdb78070b4c55a")
+    );
+    check_conversions!(
+        Aes192,
+        Aes192Enc,
+        Aes192Dec,
+        hex!("000102030405060708090a0b0c0d0e0f1011121314151617"),
+        hex!("dda97ca4864cdfe06eaf70a0ec0d7191")
+    );
+    check_conversions!(
+        Aes256,
+        Aes256Enc,
+        Aes256Dec,
+        hex!("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"),
+        hex!("8ea2b7ca516745bfeafc49904b496089")
+    );
+}
