From 0c04c2cfa73394d92c19bf51351e0cd860485ecb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 19:59:14 +0000
Subject: [PATCH] sha1w: add pure-Rust sha1-rustcrypto backend and
 rust-tls-no-provider

A rustls build (`rust-tls`) always compiles aws-lc: `sha1-ring` is
implemented with aws_lc_rs::digest, and reqwest 0.13's `rustls` feature
selects aws-lc-rs as its provider. Applications already using another
rustls provider (e.g. ring) carry a second crypto stack and a C/CMake
build just for librqbit.

Add, without changing existing feature sets:
- librqbit-sha1-wrapper `sha1-rustcrypto`: RustCrypto sha1/sha2 0.11,
  pure Rust with runtime-selected SHA-NI (x86) and SHA extensions
  (aarch64). ~1650 MB/s vs aws-lc's ~1750 MB/s on x86_64 with SHA-NI
  (ring 0.17 measured 440 MB/s, hence not ring).
- librqbit-core `sha1-rustcrypto` passthrough, and the backend added to
  the torrent_from_bytes cfg gates.
- librqbit `rust-tls-no-provider`: reqwest/rustls-no-provider plus the
  RustCrypto backend. The application installs its rustls CryptoProvider
  before creating a Session.
- FIPS 180-1 SHA-1 vectors for every backend; CI clippy/tests for the
  new feature set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/test.yml                   |  5 ++
 Cargo.lock                                   |  2 +
 Cargo.toml                                   |  2 +
 crates/librqbit/Cargo.toml                   |  9 ++
 crates/librqbit_core/Cargo.toml              |  1 +
 crates/librqbit_core/src/torrent_metainfo.rs | 18 +++-
 crates/sha1w/Cargo.toml                      |  6 ++
 crates/sha1w/src/lib.rs                      | 93 +++++++++++++++++++-
 8 files changed, 132 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index ec0744b7..43bce1ed 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -35,6 +35,11 @@ jobs:
       - name: clippy check
         run: cargo clippy --all-targets
 
+      - name: check pure-Rust TLS/hash feature set
+        run: |
+          cargo clippy -p librqbit --no-default-features --features rust-tls-no-provider --all-targets
+          cargo test -p librqbit-sha1-wrapper --no-default-features --features sha1-rustcrypto
+
   test:
     strategy:
       matrix:
diff --git a/Cargo.lock b/Cargo.lock
index ac202dae..b8338d28 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3261,6 +3261,8 @@ dependencies = [
  "assert_cfg",
  "aws-lc-rs",
  "crypto-hash",
+ "sha1",
+ "sha2 0.11.1",
 ]
 
 [[package]]
diff --git a/Cargo.toml b/Cargo.toml
index 0a05530e..d3661bd0 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -134,6 +134,8 @@ serde_derive = "1"
 serde_json = "1"
 serde_urlencoded = "0.7"
 serde_with = "3"
+sha1 = { version = "0.11", default-features = false }
+sha2 = { version = "0.11", default-features = false }
 signal-hook = "0.3"
 size_format = "1"
 socket2 = "0.6"
diff --git a/crates/librqbit/Cargo.toml b/crates/librqbit/Cargo.toml
index 1623e225..1ca7cd46 100644
--- a/crates/librqbit/Cargo.toml
+++ b/crates/librqbit/Cargo.toml
@@ -28,6 +28,15 @@ default-tls = [
 miri = []
 prometheus = ["metrics-exporter-prometheus"]
 rust-tls = ["reqwest/rustls", "sha1w/sha1-ring", "librqbit-core/sha1-ring"]
+# rustls without a bundled crypto provider, and pure-Rust SHA-1/SHA-256: no C
+# toolchain or aws-lc. The application must install a rustls CryptoProvider
+# (for example `rustls::crypto::ring::default_provider().install_default()`)
+# before creating a Session; reqwest panics when building a client otherwise.
+rust-tls-no-provider = [
+    "reqwest/rustls-no-provider",
+    "sha1w/sha1-rustcrypto",
+    "librqbit-core/sha1-rustcrypto",
+]
 storage_middleware = ["lru"]
 storage_examples = []
 tracing-subscriber-utils = ["tracing-subscriber"]
diff --git a/crates/librqbit_core/Cargo.toml b/crates/librqbit_core/Cargo.toml
index ee446782..5d52b589 100644
--- a/crates/librqbit_core/Cargo.toml
+++ b/crates/librqbit_core/Cargo.toml
@@ -13,6 +13,7 @@ readme = "README.md"
 default = ["sha1-crypto-hash"]
 sha1-crypto-hash = ["sha1w/sha1-crypto-hash"]
 sha1-ring = ["sha1w/sha1-ring"]
+sha1-rustcrypto = ["sha1w/sha1-rustcrypto"]
 
 [dependencies]
 tracing.workspace = true
diff --git a/crates/librqbit_core/src/torrent_metainfo.rs b/crates/librqbit_core/src/torrent_metainfo.rs
index 2e39e917..32a8aa62 100644
--- a/crates/librqbit_core/src/torrent_metainfo.rs
+++ b/crates/librqbit_core/src/torrent_metainfo.rs
@@ -22,7 +22,11 @@ pub struct ParsedTorrent<BufType> {
 }
 
 /// Parse torrent metainfo from bytes (includes info_hash).
-#[cfg(any(feature = "sha1-ring", feature = "sha1-crypto-hash"))]
+#[cfg(any(
