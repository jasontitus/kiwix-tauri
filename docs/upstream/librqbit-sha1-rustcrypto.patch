+))]
 pub fn torrent_from_bytes<'de>(
     buf: &'de [u8],
 ) -> Result<TorrentMetaV1<ByteBuf<'de>>, bencode::DeserializeError> {
@@ -534,7 +538,11 @@ mod tests {
     }
 
     #[test]
-    #[cfg(any(feature = "sha1-ring", feature = "sha1-crypto-hash"))]
+    #[cfg(any(
+        feature = "sha1-ring",
+        feature = "sha1-crypto-hash",
+        feature = "sha1-rustcrypto"
+    ))]
     fn test_deserialize_torrent_with_info_hash() {
         let torrent: TorrentMetaV1Borrowed = torrent_from_bytes(TORRENT_BYTES).unwrap();
         assert_eq!(
@@ -585,7 +593,11 @@ mod tests {
     }
 
     #[test]
-    #[cfg(any(feature = "sha1-ring", feature = "sha1-crypto-hash"))]
+    #[cfg(any(
+        feature = "sha1-ring",
+        feature = "sha1-crypto-hash",
+        feature = "sha1-rustcrypto"
+    ))]
     fn test_private_real_torrent() {
         let buf = include_bytes!("resources/test/private.torrent");
         let torrent: TorrentMetaV1Borrowed = from_bytes(buf).unwrap();
diff --git a/crates/sha1w/Cargo.toml b/crates/sha1w/Cargo.toml
index 3e6556f3..04634025 100644
--- a/crates/sha1w/Cargo.toml
+++ b/crates/sha1w/Cargo.toml
@@ -13,9 +13,15 @@ readme = "README.md"
 [features]
 default = ["sha1-crypto-hash"]
 sha1-crypto-hash = ["crypto-hash"]
+# Despite its name, this backend is implemented with aws-lc-rs.
 sha1-ring = ["aws-lc-rs"]
+# Pure Rust (RustCrypto). Uses SHA-NI on x86/x86_64 and the SHA extensions on
+# aarch64, selected at runtime, so no C toolchain is needed.
+sha1-rustcrypto = ["dep:sha1", "dep:sha2"]
 
 [dependencies]
 assert_cfg.workspace = true
 crypto-hash = { workspace = true, optional = true }
 aws-lc-rs = { workspace = true, optional = true }
+sha1 = { workspace = true, optional = true }
+sha2 = { workspace = true, optional = true }
diff --git a/crates/sha1w/src/lib.rs b/crates/sha1w/src/lib.rs
index 3cffb563..3c2cc6fd 100644
--- a/crates/sha1w/src/lib.rs
+++ b/crates/sha1w/src/lib.rs
@@ -28,6 +28,7 @@ pub trait ISha256 {
 assert_cfg::exactly_one! {
     feature = "sha1-crypto-hash",
     feature = "sha1-ring",
+    feature = "sha1-rustcrypto",
 }
 
 #[cfg(feature = "sha1-crypto-hash")]
@@ -140,6 +141,52 @@ mod ring_impl {
     }
 }
 
+#[cfg(feature = "sha1-rustcrypto")]
+mod rustcrypto_impl {
+    use super::{ISha1, ISha256};
+    use sha2::Digest;
+
+    pub struct Sha1RustCrypto {
+        inner: sha1::Sha1,
+    }
+
+    impl ISha1 for Sha1RustCrypto {
+        fn new() -> Self {
+            Self {
+                inner: sha1::Sha1::new(),
+            }
+        }
+
+        fn update(&mut self, buf: &[u8]) {
+            self.inner.update(buf);
+        }
+
+        fn finish(self) -> [u8; 20] {
+            self.inner.finalize().into()
+        }
+    }
+
+    pub struct Sha256RustCrypto {
+        inner: sha2::Sha256,
+    }
+
+    impl ISha256 for Sha256RustCrypto {
+        fn new() -> Self {
+            Self {
+                inner: sha2::Sha256::new(),
+            }
+        }
+
+        fn update(&mut self, buf: &[u8]) {
+            self.inner.update(buf);
+        }
+
+        fn finish(self) -> [u8; 32] {
+            self.inner.finalize().into()
+        }
+    }
+}
+
 #[cfg(feature = "sha1-crypto-hash")]
 pub type Sha1 = crypto_hash_impl::Sha1CryptoHash;
 
@@ -152,9 +199,53 @@ pub type Sha256 = crypto_hash_impl::Sha256CryptoHash;
 #[cfg(feature = "sha1-ring")]
 pub type Sha256 = ring_impl::Sha256Ring;
 
+#[cfg(feature = "sha1-rustcrypto")]
+pub type Sha1 = rustcrypto_impl::Sha1RustCrypto;
+
+#[cfg(feature = "sha1-rustcrypto")]
+pub type Sha256 = rustcrypto_impl::Sha256RustCrypto;
+
 #[cfg(test)]
 mod tests {
-    use super::{ISha256, Sha256};
+    use super::{ISha1, ISha256, Sha1, Sha256};
+
+    fn sha1_of(chunks: &[&[u8]]) -> [u8; 20] {
+        let mut h = Sha1::new();
+        for chunk in chunks {
+            h.update(chunk);
+        }
+        h.finish()
+    }
+
+    #[test]
+    fn test_sha1_known_vectors() {
+        // FIPS 180-1 / RFC 3174 test vectors.
+        assert_eq!(
+            sha1_of(&[b"abc"]),
+            [
+                0xa9, 0x99, 0x3e, 0x36, 0x47, 0x06, 0x81, 0x6a, 0xba, 0x3e, 0x25, 0x71, 0x78, 0x50,
+                0xc2, 0x6c, 0x9c, 0xd0, 0xd8, 0x9d,
+            ]
+        );
+        assert_eq!(
+            sha1_of(&[
+                b"abcdbcdecdefdefgefghfghighij",
+                b"hijkijkljklmklmnlmnomnopnopq"
+            ]),
+            [
+                0x84, 0x98, 0x3e, 0x44, 0x1c, 0x3b, 0xd2, 0x6e, 0xba, 0xae, 0x4a, 0xa1, 0xf9, 0x51,
+                0x29, 0xe5, 0xe5, 0x46, 0x70, 0xf1,
+            ]
+        );
+        let million_a = vec![b'a'; 1_000_000];
+        assert_eq!(
+            sha1_of(&[&million_a]),
+            [
+                0x34, 0xaa, 0x97, 0x3c, 0xd4, 0xc4, 0xda, 0xa4, 0xf6, 0x1e, 0xeb, 0x2b, 0xdb, 0xad,
+                0x27, 0x31, 0x65, 0x34, 0x01, 0x6f,
+            ]
+        );
+    }
 
     fn assert_sha256_impl<T: ISha256>() {}
 
