[package]
name = "sha1"
version = "0.11.0"
authors = ["RustCrypto Developers"]
edition = "2024"
rust-version = "1.85"
documentation = "https://docs.rs/sha1"
readme = "README.md"
repository = "https://github.com/RustCrypto/hashes"
license = "MIT OR Apache-2.0"
keywords = ["sha1", "hash", "digest"]
categories = ["cryptography", "no-std"]
description = "SHA-1 hash function"

[dependencies]
digest = "0.11"
cfg-if = "1.0"

[target.'cfg(any(target_arch = "x86", target_arch = "x86_64", all(target_arch = "aarch64", not(any(target_os = "android", target_os = "linux")))))'.dependencies]
cpufeatures = "0.3"

[dev-dependencies]
digest = { version = "0.11", features = ["dev"] }
hex-literal = "1"

[features]
std = []
default = ["alloc", "oid"]
alloc = ["digest/alloc"]
oid = ["digest/oid"] # Enable OID support
zeroize = ["digest/zeroize"]

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(sha1_backend, values("aarch64-sha2", "x86-sha", "soft"))'] }

[package.metadata.docs.rs]
all-features = true

# Keep the standalone crate checks on the paired local digest stack.
[patch.crates-io]
block-buffer = { path = "../block-buffer-0.12.1" }
digest = { path = "../digest-0.11.3" }
hybrid-array = { path = "../hybrid-array-0.4.15" }
