{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiwix",
  "version": "0.1.0",
  "identifier": "org.kiwix.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiwix",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true,
        "incognito": true,
        "backgroundColor": "#f2f2f7",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 13 },
        "tabbingIdentifier": "org.kiwix.workbench.reader"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://*.localhost:*; frame-ancestors 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "src/localswarm/NOTICE": "licenses/localswarm/NOTICE",
      "src/localswarm/LICENSE-APACHE": "licenses/localswarm/LICENSE-APACHE",
      "vendor/cssparser-0.37.0/KIWIX-SOURCE.txt": "licenses/cssparser/SOURCE.txt",
      "vendor/cssparser-0.37.0/Cargo.toml": "licenses/cssparser/source/Cargo.toml",
      "vendor/cssparser-0.37.0/Cargo.toml.orig": "licenses/cssparser/source/Cargo.toml.orig",
      "vendor/cssparser-0.37.0/Cargo.lock": "licenses/cssparser/source/Cargo.lock",
      "vendor/cssparser-0.37.0/LICENSE": "licenses/cssparser/source/LICENSE",
      "vendor/cssparser-0.37.0/README.md": "licenses/cssparser/source/README.md",
      "vendor/cssparser-0.37.0/src": "licenses/cssparser/source/src",
      "licenses/html5ever": "licenses/html5ever",
      "licenses/tendril": "licenses/tendril",
      "licenses/string-cache": "licenses/string-cache",
      "licenses/siphasher": "licenses/siphasher",
      "vendor/chardetng-1.0.0/COPYRIGHT": "licenses/chardetng/COPYRIGHT",
