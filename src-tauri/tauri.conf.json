      "vendor/encoding_rs-0.8.44/LICENSE-WHATWG": "licenses/encoding_rs/LICENSE-WHATWG",
      "vendor/memchr-2.8.3/LICENSE-MIT": "licenses/memchr/LICENSE-MIT",
