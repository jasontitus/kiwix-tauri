      "vendor/mdns-sd/LICENSE-APACHE": "licenses/mdns-sd/LICENSE-APACHE",
      "vendor/mdns-sd/LICENSE-MIT": "licenses/mdns-sd/LICENSE-MIT"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Your offline knowledge, in one place",
    "fileAssociations": [
      {
        "ext": ["zim", "zimaa"],
        "mimeType": "application/x-zim",
        "description": "ZIM offline archive",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
