{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local trusted application shell only; archive origins have no capabilities.",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
