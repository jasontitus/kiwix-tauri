<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Normal install-time permission required by Android 14+ for the
         mediaPlayback foreground type used by native read-aloud. No runtime
         permission is requested; microphone access is never used. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- LocalOnlyHotspot on Android 13+; ACCESS_FINE_LOCATION (host app) covers older releases.
         CHANGE_WIFI_STATE above is required by startLocalOnlyHotspot on every release. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Android 17 (API 37) blocks every local-network socket until this runtime
         permission is granted. It is part of the NEARBY_DEVICES group, so an
         existing Bluetooth or nearby-Wi-Fi grant is sufficient and no second
         sheet is shown. Apps targeting 36 or lower must not declare it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Dedicated trusted-shell pairing permissions; no archive geolocation/camera authority. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Pre-31 BLE scanning and exact WifiInfo association proof (also 33+).
         Runtime consent is a separate nearby operation, never a reader location grant. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Voice search delegates audio to an installed recognizer activity.
             No RECORD_AUDIO permission is requested or used. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
    <application android:supportsRtl="true" android:localeConfig="@xml/kiwix_locales_config">
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false" android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
        <receiver android:name="org.kiwix.mobile.KiwixExportChoiceReceiver" android:exported="false" />
        <!-- Home-screen search. The system/launcher delivers APPWIDGET_UPDATE,
             so redraws never require a live application process. -->
        <receiver android:name="org.kiwix.mobile.KiwixSearchWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.APPLICATION_LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/kiwix_search_widget_info" />
        </receiver>
        <service android:name="org.kiwix.mobile.KiwixTransferService"
            android:exported="false" android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
        <service android:name="org.kiwix.mobile.KiwixSpeechService"
            android:exported="false" android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />
        <provider android:name="org.kiwix.mobile.KiwixExportFileProvider"
            android:authorities="${applicationId}.kiwix.mobile.exports"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/kiwix_mobile_export_paths" />
        </provider>
    </application>
</manifest>
