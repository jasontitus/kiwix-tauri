+#ifdef HAVE_PREAD
+size_t
+io_pread(int fd, char * p, size_t n, off_t offset, size_t min)
+{
+    if (rare(offset < 0 ||
+	     uintmax_t(n) > uintmax_t(std::numeric_limits<off_t>::max()) -
+			    uintmax_t(offset)))
+	throw Xapian::DatabaseCorruptError("Positional read offset out of range");
+    size_t total = 0;
+    while (n) {
+	ssize_t c = pread(fd, p, n, offset);
+	if (c <= 0) {
+	    if (c == 0) {
+		if (total >= min) break;
+		throw Xapian::DatabaseCorruptError("Couldn't read enough (EOF)");
+	    }
+	    if (errno == EINTR) continue;
+	    throw Xapian::DatabaseError("Error reading from file", errno);
+	}
+	p += c;
+	total += c;
+	n -= c;
+	offset += c;
+    }
+    return total;
+}
+#endif
