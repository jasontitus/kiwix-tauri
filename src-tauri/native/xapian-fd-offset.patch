+    string path2 = get_database_path("apitest_simpledata2");
+    string embedded_path = path + "-explicit-offset";
+    uint64_t offset = 1234;
+    ofstream out(embedded_path, fstream::trunc|fstream::binary);
+    out.seekp(offset);
+    out << ifstream(path, fstream::binary).rdbuf();
+    uint64_t offset2 = uint64_t(out.tellp()) + 97;
+    out.seekp(offset2);
+    out << ifstream(path2, fstream::binary).rdbuf();
+    out.close();
+    TEST(out.good());
+
+    FD caller(open(embedded_path.c_str(), O_RDONLY|O_BINARY));
+    TEST(caller >= 0);
+    FD observer(dup(caller));
+    TEST(observer >= 0);
+    TEST_EQUAL(lseek(caller, 17, SEEK_SET), 17);
+    int reused_fd = caller;
+    FD replacement;
+    {
+	Xapian::Database first =
+	    Xapian::Database::open_fd_at(dup(caller), offset);
+	Xapian::Database second =
+	    Xapian::Database::open_fd_at(dup(caller), offset2,
+					 Xapian::DB_BACKEND_GLASS);
+	TEST_EQUAL(lseek(observer, 0, SEEK_CUR), 17);
+	TEST_EQUAL(first.get_doccount(), expected.get_doccount());
+	TEST_EQUAL(second.get_doccount(), expected2.get_doccount());
+	TEST_EQUAL(first.get_document(1).get_data(),
+		   expected.get_document(1).get_data());
+	TEST_EQUAL(second.get_document(1).get_data(),
+		   expected2.get_document(1).get_data());
+	TEST(!first.reopen());
+	TEST(!second.reopen());
+	TEST_EQUAL(lseek(observer, 0, SEEK_CUR), 17);
+
+#if defined HAVE_FORK && defined HAVE_SOCKETPAIR
+	// Processes also share the open-file description, without requiring a
+	// threaded test harness.  Open different embedded databases concurrently.
+	pid_t child = fork();
+	TEST(child >= 0);
+	if (child == 0) {
+	    try {
+		for (int i = 0; i != 50; ++i) {
+		    Xapian::Database db =
+			Xapian::Database::open_fd_at(dup(caller), offset2);
+		    if (db.get_doccount() != expected2.get_doccount() ||
+			db.get_document(1).get_data() !=
