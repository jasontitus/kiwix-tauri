+// Check multiplication, addition, and the complete read range before
+// converting the database-relative block number into a physical offset.
+static bool
+block_read_offset(size_t n, off_t b, off_t& o)
+{
+    if (rare(b < 0 || o < 0))
+	return false;
+    if (n == 0)
+	return true;
+    uintmax_t available = uintmax_t(std::numeric_limits<off_t>::max()) -
+			  uintmax_t(o);
+    if (rare(uintmax_t(b) > available / n))
+	return false;
+    uintmax_t relative = uintmax_t(b) * n;
+    if (rare(uintmax_t(n) > available - relative))
+	return false;
+    o += off_t(relative);
+    return true;
+}
