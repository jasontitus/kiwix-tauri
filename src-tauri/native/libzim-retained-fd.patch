+#ifndef _WIN32
+TEST_F(ZimArchive, retainedFdExtentsSurviveRenameUnlinkAndCallerReuse)
+{
+  const auto content = emptyZimArchiveContent();
+  const size_t split = 49;
+  const auto file = makeTempFile("retained_extents",
+      "prefix" + content.substr(0, split) + "gap" + content.substr(split) + "suffix");
+  const int fd = open(file->path().c_str(), O_RDONLY);
+  ASSERT_NE(fd, -1);
+  const std::vector<zim::FdInput> parts{
+      {fd, 6, split}, {fd, 6 + split + 3, content.size() - split}};
+  ASSERT_EQ(lseek(fd, 2, SEEK_SET), 2);
+  const zim::Archive archive(parts);
+  const zim::FileCompound compound(parts);
+  struct stat metadata;
+  ASSERT_EQ(fstat(fd, &metadata), 0);
+  ASSERT_EQ(lseek(fd, 0, SEEK_CUR), 2);
+  const auto moved = file->path() + ".moved";
+  ASSERT_EQ(rename(file->path().c_str(), moved.c_str()), 0);
+  ASSERT_EQ(unlink(moved.c_str()), 0);
+  zim::DEFAULTFS::FD unrelated(open("/dev/null", O_RDONLY));
+  ASSERT_NE(unrelated.getNativeHandle(), -1);
+  close(fd);
+  ASSERT_EQ(dup2(unrelated.getNativeHandle(), fd), fd);
+  zim::DEFAULTFS::FD reused(fd);
+  EXPECT_TRUE(archive.check());
+  EXPECT_EQ(archive.getFilesize(), content.size());
+  EXPECT_EQ(compound.getMTime(), metadata.st_mtime);
+  EXPECT_EQ(lseek(reused.getNativeHandle(), 0, SEEK_CUR), 0);
+}
+
+TEST_F(ZimArchive, invalidLaterFdExtentReleasesEveryOwnedDuplicate)
+{
+  const auto file = makeTempFile("invalid_extent", emptyZimArchiveContent());
+  const auto size = emptyZimArchiveContent().size();
+  auto probe = zim::DEFAULTFS::duplicateFile(file->fd());
+  const int firstFree = probe.getNativeHandle();
+  probe.close();
+  const std::vector<zim::FdInput> invalid{
+      {file->fd(), 0, 0},
+      {file->fd(), size + 1, 1},
+      {file->fd(), size, 1},
+      {file->fd(), 1, std::numeric_limits<uint64_t>::max()},
+      {file->fd(), std::numeric_limits<uint64_t>::max(), 1},
+      {-1, 0, size}};
+  for (const auto& bad : invalid) {
+    const std::vector<zim::FdInput> parts{{file->fd(), 0, size}, bad};
+    EXPECT_THROW(zim::FileCompound{parts}, std::runtime_error);
+    auto next = zim::DEFAULTFS::duplicateFile(file->fd());
+    EXPECT_EQ(next.getNativeHandle(), firstFree);
+    EXPECT_NE(fcntl(file->fd(), F_GETFD), -1);
+  }
+  EXPECT_THROW(zim::FileCompound{std::vector<zim::FdInput>{}}, std::runtime_error);
+}
