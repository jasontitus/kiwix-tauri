+TEST(DecoderStreamReaderTest, cachePublicationCostAndFinalReadShareReaderLock) {
+  std::atomic<unsigned> destroyed{0};
+  DecoderLifetimeGate gate;
+  const std::vector<std::string> blobs = {std::string(256 * 1024, 'a')};
+  const auto decoded = lifetimeClusterData(blobs);
+  auto cluster = lifetimeCluster(compress<ZSTD_INFO>(decoded), destroyed, &gate);
+  auto entered = gate.entered.get_future();
+  zim::ConcurrentCache<int, std::shared_ptr<zim::Cluster>, zim::ClusterMemorySize> cache(16 * 1024 * 1024);
+  auto producer = std::async(std::launch::async, [&]() {
+    return cache.getOrPut(1, [&]() { return cluster; });
+  });
+  const bool costEntered = entered.wait_for(std::chrono::seconds(5)) == std::future_status::ready;
+  if (!costEntered) {
+    gate.resume.set_value();
+    producer.wait();
+    FAIL() << "Cache insertion did not enter reader cost calculation";
+    return;
+  }
+  auto consumer = std::async(std::launch::async, [&]() {
+    auto ready = cache.getOrPut(1, []() -> std::shared_ptr<zim::Cluster> {
+      throw std::runtime_error("Published cache slot unexpectedly missed");
+    });
+    return std::string(ready->getBlob(zim::blob_index_t(0)));
+  });
+  const auto whileCostHeld = consumer.wait_for(std::chrono::milliseconds(25));
+  gate.resume.set_value();
+  EXPECT_FALSE(producer.get() == nullptr);
+  EXPECT_EQ(consumer.get(), blobs[0]);
+  EXPECT_EQ(whileCostHeld, std::future_status::timeout);
+  EXPECT_EQ(destroyed.load(), 1U);
+  EXPECT_EQ(cluster->getMemorySize(), 2 * sizeof(zim::offset_t) + decoded.size() / 2);
+}
