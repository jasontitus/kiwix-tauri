+TEST(DecoderStreamReaderTest, completedRawClusterKeepsReaderAndRanges) {
+  const std::vector<std::string> blobs = {"first", "second"};
+  const auto decoded = lifetimeClusterData(blobs);
+  auto input = std::make_shared<zim::BufferReader>(lifetimeInput(decoded));
+  std::atomic<unsigned> destroyed{0};
+  auto reader = std::unique_ptr<zim::IStreamReader>(new LifetimeRawReader(input, destroyed));
+  auto cluster = std::make_shared<zim::Cluster>(std::move(reader),
+      zim::Cluster::Compression::None, false, size_t(-1));
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(1))), blobs[1]);
+  EXPECT_EQ(destroyed.load(), 0U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0), zim::offset_t(1), zim::zsize_t(3))), "irs");
+  EXPECT_GT(cluster->getMemorySize(), 0U);
+  cluster.reset();
+  EXPECT_EQ(destroyed.load(), 1U);
+}
