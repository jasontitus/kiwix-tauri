+struct DecoderLifetimeGate {
+  std::promise<void> entered;
+  std::promise<void> resume;
+  std::shared_future<void> resumed = resume.get_future().share();
+  std::atomic<bool> armed{true};
+};
+
+template<class Decoder>
+class LifetimeDecoderReader : public zim::DecoderStreamReader<Decoder> {
+public:
+  LifetimeDecoderReader(std::shared_ptr<const zim::Reader> input,
+                        std::atomic<unsigned>& destroyed,
+                        DecoderLifetimeGate* gate = nullptr)
+    : zim::DecoderStreamReader<Decoder>(input), destroyed_(destroyed), gate_(gate) {}
+
+  ~LifetimeDecoderReader() override { ++destroyed_; }
+
+  size_t getMemorySize() const override {
+    const auto size = zim::DecoderStreamReader<Decoder>::getMemorySize();
+    if (gate_ && gate_->armed.exchange(false)) {
+      gate_->entered.set_value();
+      gate_->resumed.wait();
+    }
+    return size;
+  }
+
+private:
+  std::atomic<unsigned>& destroyed_;
+  DecoderLifetimeGate* gate_;
+};
+
+class LifetimeRawReader : public zim::RawStreamReader {
+public:
+  LifetimeRawReader(std::shared_ptr<const zim::Reader> input,
+                    std::atomic<unsigned>& destroyed)
+    : zim::RawStreamReader(input), destroyed_(destroyed) {}
+  ~LifetimeRawReader() override { ++destroyed_; }
+private:
+  std::atomic<unsigned>& destroyed_;
+};
+
+zim::Buffer lifetimeInput(const std::string& data) {
+  auto buffer = zim::Buffer::makeBuffer(zim::zsize_t(data.size()));
+  std::memcpy(const_cast<char*>(buffer.data()), data.data(), data.size());
+  return buffer;
+}
+
+std::string lifetimeClusterData(const std::vector<std::string>& blobs) {
+  uint32_t offset = uint32_t((blobs.size() + 1) * sizeof(uint32_t));
+  std::string data(offset, '\0');
+  for (size_t i = 0; i <= blobs.size(); ++i) {
+    zim::toLittleEndian(offset, &data[i * sizeof(uint32_t)]);
+    if (i < blobs.size()) offset += uint32_t(blobs[i].size());
+  }
+  for (const auto& blob : blobs) data += blob;
+  return data;
+}
+
+template<class Decoder = ZSTD_INFO>
+std::shared_ptr<zim::Cluster> lifetimeCluster(
+    const std::string& encoded, std::atomic<unsigned>& destroyed,
+    DecoderLifetimeGate* gate = nullptr,
+    zim::Cluster::Compression compression = zim::Cluster::Compression::Zstd) {
+  auto input = std::make_shared<zim::BufferReader>(lifetimeInput(encoded));
+  auto reader = std::unique_ptr<zim::IStreamReader>(
+      new LifetimeDecoderReader<Decoder>(input, destroyed, gate));
+  return std::make_shared<zim::Cluster>(std::move(reader), compression, false, size_t(-1));
+}
+
+TEST(DecoderStreamReaderTest, completedClustersRetireDecoderAndKeepRandomReads) {
+  for (const auto& blobs : std::vector<std::vector<std::string>>{
+           {std::string(256 * 1024, 'a')}, {"first", std::string(256 * 1024, 'b')}, {"first", ""}}) {
+    std::atomic<unsigned> destroyed{0};
+    const auto decoded = lifetimeClusterData(blobs);
+    auto cluster = lifetimeCluster(compress<ZSTD_INFO>(decoded), destroyed);
+    const auto baseCost = (blobs.size() + 1) * sizeof(zim::offset_t) + decoded.size() / 2;
+    EXPECT_GT(cluster->getMemorySize(), baseCost);
+    EXPECT_EQ(destroyed.load(), 0U);
+    if (blobs.size() > 1) {
+      EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+      EXPECT_EQ(destroyed.load(), 0U);
+    }
+    const auto last = zim::blob_index_t(blobs.size() - 1);
+    EXPECT_EQ(std::string(cluster->getBlob(last, zim::offset_t(0), zim::zsize_t(1))),
+              blobs.back().substr(0, 1));
+    EXPECT_EQ(destroyed.load(), 1U);
+    EXPECT_EQ(cluster->getMemorySize(), baseCost);
+    for (size_t i = blobs.size(); i-- > 0;) {
+      EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(i))), blobs[i]);
+    }
+    cluster.reset();
+    EXPECT_EQ(destroyed.load(), 1U);
+  }
+}
+
+TEST(DecoderStreamReaderTest, concatenatedFramesRetireOnlyAfterCompleteLogicalCluster) {
+  const std::vector<std::string> blobs = {"first", std::string(256 * 1024, 'b')};
+  const auto decoded = lifetimeClusterData(blobs);
+  const auto split = (blobs.size() + 1) * sizeof(uint32_t) + blobs[0].size();
+  const auto encoded = compress<ZSTD_INFO>(decoded.substr(0, split))
+      + compress<ZSTD_INFO>(decoded.substr(split));
+  std::atomic<unsigned> destroyed{0};
+  auto cluster = lifetimeCluster(encoded, destroyed);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+  EXPECT_EQ(destroyed.load(), 0U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(1), zim::offset_t(7), zim::zsize_t(9))),
+            blobs[1].substr(7, 9));
+  EXPECT_EQ(destroyed.load(), 1U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(1))), blobs[1]);
+}
+
+TEST(DecoderStreamReaderTest, truncatedFinalBlobKeepsDecoderAndPriorBlob) {
+  const std::vector<std::string> blobs = {"first", std::string(256 * 1024, 'b')};
+  const auto decoded = lifetimeClusterData(blobs);
+  const auto split = (blobs.size() + 1) * sizeof(uint32_t) + blobs[0].size();
+  auto finalFrame = compress<ZSTD_INFO>(decoded.substr(split));
+  finalFrame.resize(finalFrame.size() / 2);
+  const auto encoded = compress<ZSTD_INFO>(decoded.substr(0, split)) + finalFrame;
+  std::atomic<unsigned> destroyed{0};
+  auto cluster = lifetimeCluster(encoded, destroyed);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+  EXPECT_THROW(cluster->getBlob(zim::blob_index_t(1)), std::runtime_error);
+  EXPECT_EQ(destroyed.load(), 0U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+  cluster.reset();
+  EXPECT_EQ(destroyed.load(), 1U);
+}
