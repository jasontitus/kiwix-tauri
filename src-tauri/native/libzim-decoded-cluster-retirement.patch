+TEST(DecoderStreamReaderTest, completedLzmaClusterAlsoRetiresDecoder) {
+  const std::vector<std::string> blobs = {"first", std::string(256 * 1024, 'b')};
+  const auto decoded = lifetimeClusterData(blobs);
+  std::string encoded(lzma_stream_buffer_bound(decoded.size()), '\0');
+  size_t size = 0;
+  ASSERT_EQ(lzma_easy_buffer_encode(1, LZMA_CHECK_CRC64, nullptr,
+      reinterpret_cast<const uint8_t*>(decoded.data()), decoded.size(),
+      reinterpret_cast<uint8_t*>(&encoded[0]), &size, encoded.size()), LZMA_OK);
+  encoded.resize(size);
+  std::atomic<unsigned> destroyed{0};
+  auto cluster = lifetimeCluster<LZMA_INFO>(encoded, destroyed, nullptr, zim::Cluster::Compression::Lzma);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+  EXPECT_EQ(destroyed.load(), 0U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(1))), blobs[1]);
+  EXPECT_EQ(destroyed.load(), 1U);
+  EXPECT_EQ(std::string(cluster->getBlob(zim::blob_index_t(0))), blobs[0]);
+}
