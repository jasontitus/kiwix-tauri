+TEST(CompressionTest, zstdStreamMemoryAccounting) {
+  ZSTD_INFO::stream_t empty;
+  EXPECT_EQ(ZSTD_INFO::state_size(empty), 0U);
+
+  ZSTD_INFO::stream_t encoder;
+  ZSTD_INFO::init_stream_encoder(&encoder, nullptr);
+  ASSERT_NE(encoder.encoder_stream, nullptr);
+  ASSERT_GT(ZSTD_sizeof_CStream(encoder.encoder_stream), 0U);
+  EXPECT_EQ(ZSTD_INFO::state_size(encoder),
+            ZSTD_sizeof_CStream(encoder.encoder_stream));
+
+  ZSTD_INFO::stream_t decoder;
+  ZSTD_INFO::init_stream_decoder(&decoder, nullptr);
+  ASSERT_NE(decoder.decoder_stream, nullptr);
+  ASSERT_GT(ZSTD_sizeof_DStream(decoder.decoder_stream), 0U);
+  EXPECT_EQ(ZSTD_INFO::state_size(decoder),
+            ZSTD_sizeof_DStream(decoder.decoder_stream));
+}
