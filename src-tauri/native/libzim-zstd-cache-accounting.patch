+TEST(DecoderStreamReaderTest, zstdClusterCostIncludesDecoderBeforeBlobRead) {
+  const std::string payload(256 * 1024, 'a');
+  std::string decoded(2 * sizeof(uint32_t), '\0');
+  zim::toLittleEndian(uint32_t(decoded.size()), &decoded[0]);
+  zim::toLittleEndian(uint32_t(decoded.size() + payload.size()),
+                      &decoded[sizeof(uint32_t)]);
+  decoded += payload;
+  const auto compressed = compress<ZSTD_INFO>(decoded);
+  const std::string encoded = std::string(1, '\5') + compressed;
+  auto buffer = zim::Buffer::makeBuffer(encoded.data(), zim::zsize_t(encoded.size()));
+  const auto readCluster = [&]() {
+    return zim::Cluster::read(zim::BufferReader(buffer), zim::offset_t(0));
+  };
+
+  // FileImpl caches a cluster immediately after its offset table is decoded,
+  // before any getBlob(). Decoder window allocation must count at that point.
+  auto first = readCluster();
+  const auto cost = first->getMemorySize();
+  const auto costWithoutDecoder = 2 * sizeof(zim::offset_t) + decoded.size() / 2
+      + compressed.size() + std::min<size_t>(1024, compressed.size());
+  ASSERT_LT(compressed.size() + std::min<size_t>(1024, compressed.size()), decoded.size());
+  ASSERT_GT(cost, costWithoutDecoder);
+
+  // Keep the ordinary ConcurrentCache admission/eviction contract, including
+  // live readers retaining their cluster after its cache entry is evicted.
+  zim::ConcurrentCache<int, std::shared_ptr<zim::Cluster>, zim::ClusterMemorySize>
+      cache(cost);
+  std::weak_ptr<zim::Cluster> retired = first;
+  cache.getOrPut(1, [&]() { return std::move(first); });
+  ASSERT_FALSE(retired.expired());
+  auto second = cache.getOrPut(2, readCluster);
+  EXPECT_TRUE(retired.expired());
+  EXPECT_EQ(cache.getCurrentCost(), cost);
+  EXPECT_EQ(std::string(second->getBlob(zim::blob_index_t(0))), payload);
+  cache.setMaxCost(0);
+  EXPECT_EQ(cache.getCurrentCost(), 0U);
+  EXPECT_EQ(std::string(second->getBlob(zim::blob_index_t(0))), payload);
+}
+
 } // unnamed namespace
